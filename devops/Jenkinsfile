def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}
pipeline {
    agent any

    stages {
        stage('Test') {
            steps {
                runInDocker('python:3.9-slim') {
                    sh 'make test'
                }
            }
        }

        stage('Lint') {
            steps {
                runInDocker('python:3.9-slim') {
                    sh 'make lint'
                }
            }
        }
    }
}
