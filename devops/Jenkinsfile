def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}
pipeline {
    agent any

     environment {
        DOCKER_IMAGE = ''
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -f devops/ci.Dockerfile -t python-app:latest .'
                    env.DOCKER_IMAGE = 'python-app:latest'
                    echo "Docker image built: ${env.DOCKER_IMAGE}"
                }
            }
        }

        stage('Test') {
            steps {
                runInDocker(DOCKER_IMAGE) {
                    sh 'make test'
                }
            }
        }

        stage('Lint') {
            steps {
                runInDocker(DOCKER_IMAGE) {
                    sh 'make lint'
                }
            }
        }
    }
}
