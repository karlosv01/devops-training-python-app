def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}
pipeline {
    agent any

    stages {
        stage('Build image') {
            steps {
                script { 
                    docker.build('python-app:latest', '-f devops/ci.Dockerfile .')
                    echo "Docker image built successfully: python-app:latest"
                }
            }
        }

        stage('Test') {
            steps {
                runInDocker('python-app:latest') {
                    sh 'pytest -q'
                }
            }
        }

        stage('Lint') {
            steps {
                runInDocker('python-app:latest') {
                    sh 'make lint'
                }
            }
        }
    }
}
