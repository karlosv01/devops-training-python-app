pipeline {
agent {
        dockerfile {
            filename 'devops/ci.Dockerfile'
            dir '.' // Contexto en la raíz para que Docker acceda a todo
        }
    }
    stages {
       stage('Test') {
           
            steps {
                sh 'pytest -q'
            }
        }
         stage('Lint') {
          
            steps {
                sh 'make lint'
            }
        }
    }
}
